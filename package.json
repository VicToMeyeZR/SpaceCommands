    "discord-slash-commands",
    "discord-interactions",
    "discord-modals",
    "discord-buttons",
    "discord-select-menus",
    "discord-context-menus",
    "discord-polls",
    "discord-automod",
    "discord-entitlements",
    "discord-monetization"
